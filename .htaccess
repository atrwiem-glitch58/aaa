# ======================================================================
# SÉCURITÉ GLOBALE DU SITE ATELIER WILLEHEM
# ======================================================================

# 1. DÉSACTIVER LE LISTAGE DES RÉPERTOIRES (Empêche de voir les logs/fichiers)
Options -Indexes

# 2. MASQUER LA SIGNATURE DU SERVEUR
ServerSignature Off

# 3. FORCER LE HTTPS ET LE DOMAINE SANS WWW
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Rediriger HTTP vers HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Rediriger www vers non-www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# 4. BLOQUER L'ACCÈS AUX FICHIERS SENSIBLES (Logs, Git, Env, Configuration)
<FilesMatch "^\.|\.(log|ini|env|bak|conf|sql|sh|md)$">
    Require all denied
</FilesMatch>

<DirectoryMatch "^\.|\/\.">
    Require all denied
</DirectoryMatch>

# 5. EN-TÊTES DE SÉCURITÉ HTTP (Security Headers)
<IfModule mod_headers.c>
    # Protéger contre le Clickjacking (empêche l'intégration du site dans une iframe externe)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Empêcher le navigateur de deviner les types MIME (réduit les risques XSS)
    Header always set X-Content-Type-Options "nosniff"
    
    # Activer la protection XSS intégrée des navigateurs
    Header always set X-XSS-Protection "1; mode=block"
    
    # Forcer l'utilisation du HTTPS par les navigateurs (HSTS) pendant 1 an
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Politique de référent stricte
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Désactiver les API sensibles du navigateur non nécessaires pour ce site (Micro, Caméra, Géoloc, etc.)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    
    # Content Security Policy (CSP) basique mais robuste (Adaptée pour GTM et Google Fonts)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-src 'self' https://www.google.com/maps/ https://www.googletagmanager.com;"
</IfModule>

# 6. OPTIMISATIONS ET CACHE BROWSER (Bonus Performance & Sécurité)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 7. BLOQUER L'INJECTION DE SCRIPTS / REQUÊTES MALVEILLANTES
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule ^(.*)$ - [F,L]
</IfModule>
